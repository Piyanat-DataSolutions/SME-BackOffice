<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Payroll Pro+ — ระบบเงินเดือน OT และภาษี อัตโนมัติ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700&family=IBM+Plex+Sans+Thai:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #FBFBFD;
    --bg-alt: #F5F5F7;
    --navy: #13233B;
    --navy-light: #1E3A5F;
    --text: #1D1D1F;
    --text-secondary: #6E6E73;
    --blue: #0071E3;
    --blue-hover: #0077ED;
    --gold: #B8860B;
    --line: rgba(0,0,0,0.08);
    --radius-lg: 28px;
    --radius-md: 18px;
    --radius-sm: 12px;
    --maxw: 1120px;
  }
  *{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:'IBM Plex Sans Thai','Prompt',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    -webkit-font-smoothing:antialiased;
    line-height:1.6;
  }
  h1,h2,h3,h4{
    font-family:'Prompt','IBM Plex Sans Thai',sans-serif;
    margin:0;
    letter-spacing:-0.02em;
    color:var(--text);
  }
  p{ margin:0; }
  a{ text-decoration:none; color:inherit; }
  img{ max-width:100%; display:block; }
  .container{ max-width:var(--maxw); margin:0 auto; padding:0 24px; }
  .section{ padding:120px 0; }
  .section-alt{ background:var(--bg-alt); }
  .eyebrow{
    font-size:15px; color:var(--blue); font-weight:600; margin-bottom:14px;
  }
  .center{ text-align:center; }
  .lede{
    font-size:21px; color:var(--text-secondary); max-width:640px; line-height:1.65; font-weight:300;
  }
  .lede.center{ margin-left:auto; margin-right:auto; }

  /* ===== NAV ===== */
  nav{
    position:sticky; top:0; z-index:100;
    background:rgba(251,251,253,0.8);
    backdrop-filter:saturate(180%) blur(20px);
    -webkit-backdrop-filter:saturate(180%) blur(20px);
    border-bottom:1px solid var(--line);
  }
  .navwrap{
    max-width:var(--maxw); margin:0 auto; padding:0 24px;
    height:52px; display:flex; align-items:center; justify-content:space-between;
  }
  .brand{ font-family:'Prompt',sans-serif; font-weight:700; font-size:17px; letter-spacing:-0.01em; color:var(--navy); }
  .navlinks{ display:flex; gap:32px; }
  .navlinks a{ font-size:13.5px; color:var(--text); opacity:0.85; }
  .navlinks a:hover{ opacity:1; }
  .navcta{
    font-size:13px; background:var(--text); color:#fff; padding:7px 16px; border-radius:980px;
  }
  .navcta:hover{ background:#000; }
  @media(max-width:700px){ .navlinks{ display:none; } }

  /* ===== HERO ===== */
  .hero{ padding:96px 0 0; text-align:center; overflow:hidden; }
  .hero-badge{
    display:inline-block; font-size:13px; font-weight:500; color:var(--gold);
    background:#FDF3D9; padding:6px 16px; border-radius:980px; margin-bottom:28px;
    opacity:0; animation: fadeUp 0.7s ease-out 0.05s forwards;
  }
  .hero h1{
    font-size:clamp(40px,6vw,72px); font-weight:700; line-height:1.08;
    background:linear-gradient(180deg,#1D1D1F 0%, #3A3A3E 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    opacity:0; animation: fadeUp 0.8s ease-out 0.15s forwards;
  }
  .hero .lede{
    margin:24px auto 0; opacity:0; animation: fadeUp 0.8s ease-out 0.3s forwards;
  }
  .hero-ctas{
    display:flex; gap:14px; justify-content:center; margin-top:36px;
    opacity:0; animation: fadeUp 0.8s ease-out 0.42s forwards;
  }
  .btn-primary{
    background:var(--blue); color:#fff; padding:13px 28px; border-radius:980px; font-size:16px; font-weight:500;
    transition:background 0.2s, transform 0.2s;
  }
  .btn-primary:hover{ background:var(--blue-hover); }
  .btn-secondary{
    background:transparent; color:var(--blue); padding:13px 22px; border-radius:980px; font-size:16px; font-weight:500;
    border:1px solid rgba(0,113,227,0.3);
    transition:background 0.2s;
  }
  .btn-secondary:hover{ background:rgba(0,113,227,0.06); }
  .hero-shot{
    margin:64px auto 0; max-width:880px; position:relative;
    opacity:0; animation: fadeUp 1s ease-out 0.55s forwards;
  }
  .shot-frame{
    border-radius:20px; overflow:hidden;
    box-shadow: 0 40px 80px -30px rgba(19,35,59,0.35), 0 2px 6px rgba(0,0,0,0.06);
    border:1px solid rgba(0,0,0,0.06);
  }
  .shot-frame img{ width:100%; }
  .hero-fade{
    height:90px; margin-top:-90px; position:relative;
    background:linear-gradient(180deg, rgba(251,251,253,0) 0%, var(--bg) 90%);
  }
  @keyframes fadeUp{ from{ opacity:0; transform:translateY(22px);} to{ opacity:1; transform:translateY(0);} }

  /* ===== PAIN / TRANSITION ===== */
  .transition{ text-align:center; }
  .transition h2{ font-size:clamp(28px,3.6vw,40px); font-weight:600; max-width:780px; margin:0 auto; line-height:1.4; }
  .transition h2 .muted{ color:var(--text-secondary); font-weight:400; }
  .stat-row{
    display:grid; grid-template-columns:repeat(3,1fr); gap:32px; margin-top:72px;
  }
  .stat{ text-align:center; }
  .stat .num{ font-family:'Prompt',sans-serif; font-size:48px; font-weight:700; color:var(--navy); }
  .stat .label{ font-size:15px; color:var(--text-secondary); margin-top:8px; }
  @media(max-width:700px){ .stat-row{ grid-template-columns:1fr; gap:40px; } }

  /* ===== FEATURES ===== */
  .feat-head{ text-align:center; margin-bottom:64px; }
  .feat-head h2{ font-size:clamp(30px,4vw,44px); font-weight:600; }
  .feat-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line);
    border-radius:var(--radius-lg); overflow:hidden; border:1px solid var(--line);
  }
  .feat-card{ background:#fff; padding:40px 32px; }
  .feat-icon{
    width:44px; height:44px; border-radius:12px; background:var(--bg-alt);
    display:flex; align-items:center; justify-content:center; font-size:22px; margin-bottom:20px;
  }
  .feat-card h3{ font-size:19px; font-weight:600; margin-bottom:10px; }
  .feat-card p{ font-size:15px; color:var(--text-secondary); line-height:1.6; }
  @media(max-width:900px){ .feat-grid{ grid-template-columns:1fr; } }

  /* ===== SHOWCASE ===== */
  .showcase-row{
    display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center; margin-bottom:150px;
  }
  .showcase-row:last-child{ margin-bottom:0; }
  .showcase-row.reverse .showcase-text{ order:2; }
  .showcase-row.reverse .showcase-img{ order:1; }
  .showcase-text .eyebrow{ font-size:14px; }
  .showcase-text h3{ font-size:clamp(26px,3.2vw,34px); font-weight:600; line-height:1.25; margin-bottom:18px; }
  .showcase-text p{ font-size:17px; color:var(--text-secondary); line-height:1.7; }
  .showcase-img .shot-frame{ box-shadow:0 30px 60px -24px rgba(19,35,59,0.25); }
  @media(max-width:860px){
    .showcase-row, .showcase-row.reverse{ grid-template-columns:1fr; gap:36px; }
    .showcase-row.reverse .showcase-text, .showcase-row.reverse .showcase-img{ order:initial; }
    .showcase-row{ margin-bottom:90px; }
  }

  /* ===== PRICING ===== */
  .price-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:64px; align-items:stretch;
  }
  .price-card{
    background:#fff; border:1px solid var(--line); border-radius:var(--radius-lg);
    padding:40px 32px; display:flex; flex-direction:column;
  }
  .price-card.featured{
    background:var(--navy); color:#fff; border-color:var(--navy);
    box-shadow:0 30px 60px -24px rgba(19,35,59,0.5);
    transform:scale(1.035);
  }
  .price-card.featured .price-tier-desc,
  .price-card.featured .price-note{ color:rgba(255,255,255,0.65); }
  .price-badge{
    display:inline-block; font-size:12px; font-weight:600; color:var(--gold); background:#FDF3D9;
    padding:5px 14px; border-radius:980px; margin-bottom:18px; width:fit-content;
  }
  .price-card.featured .price-badge{ background:rgba(184,134,11,0.2); color:#F0C75E; }
  .price-tier{ font-size:14px; font-weight:600; color:var(--text-secondary); text-transform:none; margin-bottom:6px; }
  .price-card.featured .price-tier{ color:rgba(255,255,255,0.7); }
  .price-amount{ font-family:'Prompt',sans-serif; font-size:38px; font-weight:700; margin-bottom:4px; }
  .price-tier-desc{ font-size:13.5px; color:var(--text-secondary); margin-bottom:28px; }
  .price-list{ list-style:none; padding:0; margin:0 0 32px; flex-grow:1; }
  .price-list li{
    font-size:14.5px; padding:10px 0; border-top:1px solid var(--line); display:flex; gap:10px;
  }
  .price-card.featured .price-list li{ border-top:1px solid rgba(255,255,255,0.12); }
  .price-list li:first-child{ border-top:none; }
  .price-list li.no{ color:var(--text-secondary); }
  .price-card.featured .price-list li.no{ color:rgba(255,255,255,0.4); }
  .check{ color:#1FAE64; font-weight:700; flex-shrink:0; }
  .price-card.featured .check{ color:#5FD897; }
  .dash{ color:#C0C5CE; font-weight:700; flex-shrink:0; }
  .price-cta{
    display:block; text-align:center; padding:12px; border-radius:980px; font-size:15px; font-weight:500;
    background:var(--bg-alt); color:var(--text);
  }
  .price-card.featured .price-cta{ background:var(--blue); color:#fff; }
  .price-note{ text-align:center; font-size:13px; color:var(--text-secondary); margin-top:28px; max-width:640px; margin-left:auto; margin-right:auto; }
  @media(max-width:900px){ .price-grid{ grid-template-columns:1fr; } .price-card.featured{ transform:none; } }

  /* ===== WHY / STEPS ===== */
  .steps{ display:grid; grid-template-columns:repeat(5,1fr); gap:20px; margin-top:64px; }
  .step{ text-align:left; }
  .step .stepnum{
    font-family:'Prompt',sans-serif; font-size:14px; font-weight:600; color:var(--blue); margin-bottom:14px;
  }
  .step h4{ font-size:16px; font-weight:600; margin-bottom:8px; line-height:1.4; }
  .step p{ font-size:13.5px; color:var(--text-secondary); line-height:1.6; }
  @media(max-width:900px){ .steps{ grid-template-columns:1fr 1fr; } }
  @media(max-width:600px){ .steps{ grid-template-columns:1fr; } }

  /* ===== FAQ ===== */
  .faq-list{ max-width:760px; margin:64px auto 0; }
  details{
    border-top:1px solid var(--line); padding:24px 0;
  }
  details:last-child{ border-bottom:1px solid var(--line); }
  summary{
    cursor:pointer; list-style:none; display:flex; justify-content:space-between; align-items:center;
    font-size:18px; font-weight:500; color:var(--text);
  }
  summary::-webkit-details-marker{ display:none; }
  summary::after{
    content:'+'; font-size:24px; font-weight:300; color:var(--text-secondary); transition:transform 0.25s; margin-left:20px;
  }
  details[open] summary::after{ transform:rotate(45deg); }
  details p{ font-size:15.5px; color:var(--text-secondary); margin-top:16px; line-height:1.7; max-width:640px; }

  /* ===== CTA / FOOTER ===== */
  .cta-band{
    background:var(--navy); color:#fff; text-align:center; border-radius:var(--radius-lg);
    padding:80px 40px; margin:0 24px;
  }
  .cta-band h2{ color:#fff; font-size:clamp(28px,3.6vw,40px); font-weight:600; }
  .cta-band p{ color:rgba(255,255,255,0.65); font-size:17px; margin-top:16px; }
  .cta-band .hero-ctas{ margin-top:32px; opacity:1; animation:none; }
  .cta-band .btn-secondary{ color:#fff; border-color:rgba(255,255,255,0.3); }
  .cta-band .btn-secondary:hover{ background:rgba(255,255,255,0.08); }

  footer{ padding:56px 0 40px; text-align:center; }
  footer .brand{ margin-bottom:10px; justify-content:center; display:flex; }
  footer p{ font-size:13px; color:var(--text-secondary); }
</style>
</head>
<body>

<nav>
  <div class="navwrap">
    <div class="brand">Payroll Pro+</div>
    <div class="navlinks">
      <a href="#features">ฟีเจอร์</a>
      <a href="#showcase">ตัวอย่างผลงาน</a>
      <a href="#pricing">แพ็กเกจ</a>
      <a href="#faq">คำถาม</a>
    </div>
    <a href="#pricing" class="navcta">ดูราคา</a>
  </div>
</nav>

<header class="hero">
  <div class="container">
    <span class="hero-badge">ระบบเงินเดือนสำหรับ SME</span>
    <h1>เงินเดือน OT และภาษี<br>จบในไฟล์เดียว</h1>
    <p class="lede center">คำนวณค่าล่วงเวลา เบี้ยเลี้ยง ประกันสังคม และภาษีหัก ณ ที่จ่ายให้อัตโนมัติ พร้อมออกสลิปเงินเดือนที่พร้อมปริ้นได้ทันที โดยไม่ต้องเขียนสูตรเอง</p>
    <div class="hero-ctas">
      <a href="#pricing" class="btn-primary">ดูแพ็กเกจและราคา</a>
      <a href="#showcase" class="btn-secondary">ดูตัวอย่างผลงาน</a>
    </div>
    <div class="hero-shot">
      <div class="shot-frame"><img src="data:image/jpeg;base64," alt="Dashboard ภาพรวมองค์กร"></div>
    </div>
  </div>
  <div class="hero-fade"></div>
</header>

<section class="section transition">
  <div class="container">
    <h2>เลิกคำนวณเงินเดือนด้วยมือ <span class="muted">เลิกทำสลิปทีละคนใน Word เลิกกังวลว่าคิดภาษีผิด</span></h2>
    <div class="stat-row">
      <div class="stat"><div class="num">3</div><div class="label">ประเภท OT คำนวณอัตโนมัติตามกฎหมายแรงงาน</div></div>
      <div class="stat"><div class="num">16</div><div class="label">ประเภทเงินได้-รายการหัก ครบทุกสวัสดิการ</div></div>
      <div class="stat"><div class="num">0</div><div class="label">สูตรที่ต้องเขียนเอง — กรอกข้อมูลแล้วเสร็จ</div></div>
    </div>
  </div>
</section>

<section class="section section-alt" id="features">
  <div class="container">
    <div class="feat-head">
      <div class="eyebrow center">ฟีเจอร์หลัก</div>
      <h2>ทำอะไรให้คุณได้บ้าง</h2>
    </div>
    <div class="feat-grid">
      <div class="feat-card">
        <div class="feat-icon">⏱</div>
        <h3>คำนวณ OT อัตโนมัติ</h3>
        <p>3 ประเภทตามกฎหมายแรงงาน — วันธรรมดา วันหยุดในเวลา และ OT วันหยุด</p>
      </div>
      <div class="feat-card">
        <div class="feat-icon">💰</div>
        <h3>เงินได้เพิ่มเติม 9 ประเภท</h3>
        <p>ค่าตำแหน่ง ค่าครองชีพ เบี้ยขยัน คอมมิชชั่น โบนัส และอื่นๆ ครบ</p>
      </div>
      <div class="feat-card">
        <div class="feat-icon">📋</div>
        <h3>รายการหัก 7 ประเภท</h3>
        <p>คำนวณหักขาดงาน-มาสายอัตโนมัติจากค่าแรงจริงของพนักงานแต่ละคน</p>
      </div>
      <div class="feat-card">
        <div class="feat-icon">🧾</div>
        <h3>ภาษีและประกันสังคม</h3>
        <p>คำนวณภาษีหัก ณ ที่จ่ายแบบขั้นบันไดและประกันสังคมให้อัตโนมัติ</p>
      </div>
      <div class="feat-card">
        <div class="feat-icon">🖨</div>
        <h3>สลิปเงินเดือนพร้อมปริ้น</h3>
        <p>แสดงรายรับ-รายหักครบทุกบรรทัด ตั้งค่าหน้ากระดาษไว้ให้แล้ว</p>
      </div>
      <div class="feat-card">
        <div class="feat-icon">📊</div>
        <h3>Dashboard ภาพรวม</h3>
        <p>สรุปต้นทุนพนักงานทั้งบริษัทแยกตามแผนก พร้อมกราฟอัปเดตอัตโนมัติ</p>
      </div>
    </div>
  </div>
</section>

<section class="section" id="showcase">
  <div class="container">
    <div class="feat-head">
      <div class="eyebrow center">ตัวอย่างผลงานจริง</div>
      <h2>หน้าตาไฟล์ที่คุณจะได้รับ</h2>
    </div>

    <div class="showcase-row">
      <div class="showcase-text">
        <div class="eyebrow">ข้อมูลพนักงาน</div>
        <h3>กรอกครั้งเดียว ระบบคำนวณค่าแรงให้เอง</h3>
        <p>เพิ่มพนักงานพร้อมเงินเดือน ระบบคำนวณค่าแรงต่อวันและต่อชั่วโมงให้อัตโนมัติ ใช้เป็นฐานอ้างอิงสำหรับคำนวณ OT และรายการหักทั้งหมดในไฟล์</p>
      </div>
      <div class="showcase-img"><div class="shot-frame"><img src="data:image/jpeg;base64," alt="ชีตข้อมูลพนักงาน"></div></div>
    </div>

    <div class="showcase-row reverse">
      <div class="showcase-text">
        <div class="eyebrow">สลิปเงินเดือน</div>
        <h3>สลิปพรีเมียม ครบทุกรายละเอียด</h3>
        <p>เลือกรหัสพนักงานและเดือน สลิปทั้งใบขึ้นทันที พร้อมรายรับ 11 รายการและรายหัก 9 รายการ ตั้งค่าหน้ากระดาษ A4 พร้อมปริ้นไว้ให้แล้ว</p>
      </div>
      <div class="showcase-img"><div class="shot-frame"><img src="data:image/jpeg;base64," alt="สลิปเงินเดือน"></div></div>
    </div>

    <div class="showcase-row">
      <div class="showcase-text">
        <div class="eyebrow">Dashboard องค์กร</div>
        <h3>เห็นภาพรวมทั้งบริษัทในหน้าเดียว</h3>
        <p>สรุปต้นทุนพนักงานรายเดือน แยกตามแผนก พร้อมกราฟแสดงสัดส่วนที่อัปเดตอัตโนมัติทุกครั้งที่มีการกรอกข้อมูลใหม่</p>
      </div>
      <div class="showcase-img"><div class="shot-frame"><img src="data:image/jpeg;base64," alt="กราฟสรุปภาพรวม"></div></div>
    </div>
  </div>
</section>

<section class="section section-alt" id="pricing">
  <div class="container">
    <div class="feat-head">
      <div class="eyebrow center">แพ็กเกจและราคา</div>
      <h2>เลือกแพ็กเกจที่เหมาะกับธุรกิจของคุณ</h2>
    </div>

    <div class="price-grid">
      <div class="price-card">
        <div class="price-tier">เริ่มต้น</div>
        <div class="price-amount">1,290 บาท</div>
        <div class="price-tier-desc">ส่งงานภายใน 1 วัน</div>
        <ul class="price-list">
